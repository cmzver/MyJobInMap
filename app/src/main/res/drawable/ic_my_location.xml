<!-- Точка «моё местоположение»: нейтральный тёмный центр с белым кольцом.
     Цвет на карте несёт статус заявки — свою точку красим не в «системный синий»,
     а в спокойный тёмный, который читается на любых тайлах (и в тёмной теме — за счёт кольца). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="22dp"
    android:height="22dp"
    android:viewportWidth="22"
    android:viewportHeight="22">
    <!-- Мягкая тень, чтобы белое кольцо не терялось на светлых тайлах -->
    <path
        android:fillColor="#33000000"
        android:pathData="M11,11m-11,0a11,11 0,1 1,22 0a11,11 0,1 1,-22 0"/>
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M11,11m-10,0a10,10 0,1 1,20 0a10,10 0,1 1,-20 0"/>
    <path
        android:fillColor="#FF111827"
        android:pathData="M11,11m-7,0a7,7 0,1 1,14 0a7,7 0,1 1,-14 0"/>
</vector>
