# FieldWorker — Caddy Reverse Proxy с автоматическим SSL
# =======================================================
#
# Caddy автоматически получает и обновляет SSL сертификаты через Let's Encrypt.
# Используется с docker-compose.caddy.yml (standalone, API на хосте).
#
# Запуск:
#   DOMAIN=petrosyan.duckdns.org docker compose -f docker-compose.caddy.yml up -d

{$DOMAIN:localhost} {
    # Лимит размера запроса (аналог nginx client_max_body_size)
    request_body {
        max_size 20MB
    }

    # Корень → редирект на портал
    redir / /portal/ 302
    redir /portal /portal/ 301

    # Портал — SPA с раздачей статики
    handle_path /portal/* {
        root * /srv/portal

        # Хешированные файлы Vite кешируются навсегда. Файла нет (прошлая
        # сборка после деплоя) — честный 404: index.html под видом JS ломал
        # страницу и оседал в кеше браузера на год.
        @assets path /assets/*
        handle @assets {
            @exists file
            header @exists Cache-Control "public, max-age=31536000, immutable"
            file_server
        }

        # Остальное — SPA fallback на index.html, всегда без кеша: иначе
        # браузер держит старый index.html и просит удалённые файлы сборки.
        # (Матчер `path /index.html` сюда не годился — он видит исходный путь
        # запроса, а не подставленный try_files.)
        handle {
            header Cache-Control "no-cache"
            try_files {path} /index.html
            file_server
        }
    }

    # Favicon
    handle /favicon.ico {
        root * /srv/portal
        rewrite * /favicon.ico
        file_server
    }

    # WebSocket
    @websocket {
        path /ws
        header Connection *Upgrade*
        header Upgrade websocket
    }
    reverse_proxy @websocket localhost:8001 {
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    # Health-check — проксируется на корневой /health сервера (не под /api)
    handle /health {
        reverse_proxy localhost:8001
    }

    # API — проксирование на FastAPI (работает на хосте)
    handle /api/* {
        reverse_proxy localhost:8001 {
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Заголовки безопасности
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        X-XSS-Protection "1; mode=block"
        Referrer-Policy strict-origin-when-cross-origin
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        -Server
    }

    # Сжатие
    encode gzip zstd

    # Логи
    log {
        output stdout
        format json
    }
}

# Tiles Alliance Comms («говорилка») живёт на этом же хосте, в своём
# docker-стеке (/opt/tiles-alliance-comms, репо HUB_Messenger). 80/443 здесь
# у нас, поэтому TLS для её имён тоже снимаем мы, а дальше отдаём её
# собственному Caddy открытым HTTP на 127.0.0.1:8080 — он сам разводит
# запросы на приложение и LiveKit и ставит свои заголовки.
#
# X-Forwarded-For Caddy по умолчанию перезаписывает адресом клиента — на нём
# держится рейт-лимит входа говорилки, не добавлять сюда header_up для XFF.
# WebSocket сигналинга LiveKit reverse_proxy пробрасывает сам.
tshub.duckdns.org, livekit.tshub.duckdns.org {
    reverse_proxy 127.0.0.1:8080
}
